--========================================================--
-- 🖼️ FOTO DE PERFIL FIXA ACIMA DO NOME
-- Tamanho constante na tela: 32x32 pixels.
-- Acompanha o jogador e fica acima da caixa de texto.
--========================================================--

local function AddProfilePicture(v, character)
    if character:GetAttribute("HenriqueProfileCreated") then
        return
    end

    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")

    if not head or not torso then
        return
    end

    local success, thumbnail = pcall(function()
        return P:GetUserThumbnailAsync(
            v.UserId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size100x100
        )
    end)

    if not success or not thumbnail then
        return
    end

    character:SetAttribute("HenriqueProfileCreated", true)

    local ProfileGui = Instance.new("ScreenGui")
    ProfileGui.Name = "HenriqueProfilePicture_" .. v.UserId
    ProfileGui.ResetOnSpawn = false
    ProfileGui.IgnoreGuiInset = true
    ProfileGui.DisplayOrder = 10
    ProfileGui.Parent = PlayerGui

    local ProfileImage = Instance.new("ImageLabel")
    ProfileImage.Name = "ProfileImage"
    ProfileImage.AnchorPoint = Vector2.new(0.5, 0.5)

    -- TAMANHO FIXO: NÃO AUMENTA NEM DIMINUI COM A DISTÂNCIA
    ProfileImage.Size = UDim2.fromOffset(32, 32)
    ProfileImage.BackgroundTransparency = 1
    ProfileImage.Image = thumbnail
    ProfileImage.ScaleType = Enum.ScaleType.Crop
    ProfileImage.Visible = false
    ProfileImage.ZIndex = 20
    ProfileImage.Parent = ProfileGui

    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not ProfileGui.Parent
            or not character.Parent
            or not head.Parent then

            if connection then
                connection:Disconnect()
            end

            if ProfileGui.Parent then
                ProfileGui:Destroy()
            end

            return
        end

        local camera = workspace.CurrentCamera

        if not camera then
            ProfileImage.Visible = false
            return
        end

        -- Projeta a cabeça para a tela.
        -- O deslocamento em pixels mantém a foto logo acima do nome.
        local screenPosition, onScreen =
            camera:WorldToViewportPoint(head.Position)

        if onScreen and screenPosition.Z > 0 then
            ProfileImage.Position = UDim2.fromOffset(
                screenPosition.X,
                screenPosition.Y - 65
            )

            ProfileImage.Visible = true
        else
            ProfileImage.Visible = false
        end
    end)

    ProfileGui.Destroying:Connect(function()
        if connection then
            connection:Disconnect()
        end
    end)

    character.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            if connection then
                connection:Disconnect()
            end

            if ProfileGui.Parent then
                ProfileGui:Destroy()
            end
        end
    end)
end


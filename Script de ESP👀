local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--========================================================--
-- CONFIGURAÇÕES
--========================================================--

local MUSIC_ID = "rbxassetid://1839246711"
local IMAGE_ID = "rbxassetid://129676103296599"

-- Tempo que a intro fica parada
local HOLD_TIME = 2.5

-- Duração da animação final
local ANIMATION_TIME = 2.5

--========================================================--
-- GUI
--========================================================--

local Gui = Instance.new("ScreenGui")
Gui.Name = "HenriqueIntro"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = PlayerGui

--========================================================--
-- TEXTO
--========================================================--

local Text = Instance.new("TextLabel")
Text.Name = "ByHenrique"
Text.Parent = Gui

Text.AnchorPoint = Vector2.new(0.5, 0.5)
Text.Position = UDim2.new(0.5, 0, 0.42, 0)
Text.Size = UDim2.new(0.9, 0, 0, 90)

Text.BackgroundTransparency = 1

Text.Text = "(By henrique)"
Text.TextColor3 = Color3.fromRGB(255, 255, 255)
Text.TextTransparency = 0

Text.Font = Enum.Font.SciFi
Text.TextScaled = true
Text.TextSize = 50

Text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
Text.TextStrokeTransparency = 0.15

Text.ZIndex = 10

--========================================================--
-- IMAGEM
--========================================================--

local Image = Instance.new("ImageLabel")
Image.Name = "HenriqueImage"
Image.Parent = Gui

Image.AnchorPoint = Vector2.new(0.5, 0.5)
Image.Position = UDim2.new(0.5, 0, 0.56, 0)
Image.Size = UDim2.new(0, 100, 0, 100)

Image.BackgroundTransparency = 1
Image.Image = IMAGE_ID
Image.ImageTransparency = 0

Image.ScaleType = Enum.ScaleType.Fit
Image.ZIndex = 10

--========================================================--
-- MÚSICA
--========================================================--

local Music = Instance.new("Sound")
Music.Name = "HenriqueIntroMusic"
Music.SoundId = MUSIC_ID
Music.Volume = 0.6
Music.Looped = false
Music.Parent = SoundService

Music:Play()

--========================================================--
-- TEMPO INICIAL
--========================================================--

task.wait(HOLD_TIME)

--========================================================--
-- ANIMAÇÃO DO TEXTO
-- Sobe e desaparece
--========================================================--

local TextEndPosition = UDim2.new(
	0.5,
	0,
	0.42,
	-130
)

local TextTween = TweenService:Create(
	Text,
	TweenInfo.new(
		ANIMATION_TIME,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	),
	{
		Position = TextEndPosition,
		TextTransparency = 1,
		TextStrokeTransparency = 1
	}
)

--========================================================--
-- ANIMAÇÃO DA IMAGEM
-- Gira + diminui + desaparece
--========================================================--

local ImageTween = TweenService:Create(
	Image,
	TweenInfo.new(
		ANIMATION_TIME,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.InOut
	),
	{
		Size = UDim2.new(0, 0, 0, 0),
		ImageTransparency = 1,
		Rotation = 360
	}
)

TextTween:Play()
ImageTween:Play()

--========================================================--
-- FINALIZAÇÃO
--========================================================--

ImageTween.Completed:Wait()

if Gui then
	Gui:Destroy()
end

-- A música continua somente até o próprio áudio terminar.
-- Não existe Loop.

Music.Ended:Connect(function()
	if Music and Music.Parent then
		Music:Destroy()
	end
end)

-- Segurança para limpar o áudio caso necessário
task.delay(10, function()
	if Music and Music.Parent then
		Music:Destroy()
	end
end)


--[[
    Script de ESP👀
👀by henrique👁
]]

getgenv().Toggle = true -- This toggles the esp, turning it to false will turn it off
getgenv().TC = false -- This toggles team check, turning it on will turn on team check
local PlayerName = "Name" -- You can decide if you want the Player's name to be a display name which is "DisplayName", or username which is "Name"

--//Variables\\--
local P = game:GetService("Players")
local LP = P.LocalPlayer
local StarterGui = game:GetService("StarterGui")

--//Debounce\\--
local DB = false

--//NOTIFICAÇÃO MODIFICADA - COMO VOCÊ PEDIU!\\--
-- Primeiro limpa pra não dar erro se já tiver algo
pcall(function() StarterGui:SetCore("ResetNotification", {}) end)

-- Cria nossa notificação personalizada com IMAGEM
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Script by henrique👀",
        Text = "script ESP",
        Button1 = "Fechar",
        Duration = math.huge,
        -- IMAGEM COM O ID QUE VOCÊ PASSOU E TAMANHO AUMENTADO!
        Image = "rbxassetid://129676103296599",
        ImageSize = UDim2.new(0, 220, 0, 140), -- Tamanho maior que o padrão, bem visível
        ImageTransparency = 0
    })
end)

--//Loop\\--
while task.wait() do
    if not getgenv().Toggle then
        break
    end
    if DB then 
        return 
    end
    DB = true

    pcall(function()
        for i,v in pairs(P:GetChildren()) do
            if v:IsA("Player") then
                if v ~= LP then
                    if v.Character then

                        local pos = math.floor(((LP.Character:FindFirstChild("HumanoidRootPart")).Position - (v.Character:FindFirstChild("HumanoidRootPart")).Position).magnitude)
                        -- Credits to Infinite Yield for this part (pos) ^^^^^^

                        if v.Character:FindFirstChild("Totally NOT Esp") == nil and v.Character:FindFirstChild("Icon") == nil and getgenv().TC == false then
                            --//ESP-Highlight\\--
                            local ESP = Instance.new("Highlight", v.Character)

                            ESP.Name = "Totally NOT Esp"
                            ESP.Adornee = v.Character
                            ESP.Archivable = true
                            ESP.Enabled = true
                            ESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            ESP.FillColor = v.TeamColor.Color
                            ESP.FillTransparency = 0.5
                            ESP.OutlineColor = Color3.fromRGB(255, 255, 255)
                            ESP.OutlineTransparency = 0

                            --//ESP-Text\\--
                            local Icon = Instance.new("BillboardGui", v.Character)
                            local ESPText = Instance.new("TextLabel")

                            Icon.Name = "Icon"
                            Icon.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                            Icon.Active = true
                            Icon.AlwaysOnTop = true
                            Icon.ExtentsOffset = Vector3.new(0, 1, 0)
                            Icon.LightInfluence = 1.000
                            Icon.Size = UDim2.new(0, 800, 0, 50)

                            ESPText.Name = "ESP Text"
                            ESPText.Parent = Icon
                            ESPText.BackgroundColor3 = v.TeamColor.Color
                            ESPText.BackgroundTransparency = 1.000
                            ESPText.Size = UDim2.new(0, 800, 0, 50)
                            ESPText.Font = Enum.Font.SciFi
                            ESPText.Text = v[PlayerName].." | Distance: "..pos
                            ESPText.TextColor3 = v.TeamColor.Color
                            ESPText.TextSize = 10.800
                            ESPText.TextWrapped = true
                        else
                            if v.TeamColor ~= LP.TeamColor and v.Character:FindFirstChild("Totally NOT Esp") == nil and v.Character:FindFirstChild("Icon") == nil and getgenv().TC == true then
                                --//ESP-Highlight\\--
                                local ESP = Instance.new("Highlight", v.Character)

                                ESP.Name = "Totally NOT Esp"
                                ESP.Adornee = v.Character
                                ESP.Archivable = true
                                ESP.Enabled = true
                                ESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                ESP.FillColor = v.TeamColor.Color
                                ESP.FillTransparency = 0.5
                                ESP.OutlineColor = Color3.fromRGB(255, 255, 255)
                                ESP.OutlineTransparency = 0

                                --//ESP-Text\\--
                                local Icon = Instance.new("BillboardGui", v.Character)
                                local ESPText = Instance.new("TextLabel")

                                Icon.Name = "Icon"
                                Icon.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                                Icon.Active = true
                                Icon.AlwaysOnTop = true
                                Icon.ExtentsOffset = Vector3.new(0, 1, 0)
                                Icon.LightInfluence = 1.000
                                Icon.Size = UDim2.new(0, 800, 0, 50)

                                ESPText.Name = "ESP Text"
                                ESPText.Parent = Icon
                                ESPText.BackgroundColor3 = v.TeamColor.Color
                                ESPText.BackgroundTransparency = 1.000
                                ESPText.Size = UDim2.new(0, 800, 0, 50)
                                ESPText.Font = Enum.Font.SciFi
                                ESPText.Text = v[PlayerName].." | Distance: "..pos
                                ESPText.TextColor3 = v.TeamColor.Color
                                ESPText.TextSize = 10.800
                                ESPText.TextWrapped = true
                            else
                                if not v.Character:FindFirstChild("Totally NOT Esp").FillColor == v.TeamColor.Color and not v.Character:FindFirstChild("Icon").TextColor3 == v.TeamColor.Color then
                                    v.Character:FindFirstChild("Totally NOT Esp").FillColor = v.TeamColor.Color
                                    v.Character:FindFirstChild("Icon").TextColor3 = v.TeamColor.Color
                                else
                                    if v.Character:FindFirstChild("Totally NOT Esp").Enabled == false and v.Character:FindFirstChild("Icon").Enabled == false then
                                        v.Character:FindFirstChild("Totally NOT Esp").Enabled = true
                                        v.Character:FindFirstChild("Icon").Enabled = true
                                    else
                                        if v.Character:FindFirstChild("Icon") then
                                            v.Character:FindFirstChild("Icon")["ESP Text"].Text = v[PlayerName].." | Distance: "..pos
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    wait()

    DB = false
end
